@model AppleShop.Models.Order
@{
    ViewBag.Title = "Đơn hàng " + Model.OrderCode;
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
        Đơn hàng @Model.OrderCode
        <span class="badge @Model.StatusBadgeClass align-middle">@Model.StatusText</span>
    </h1>
    <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary"><i class="fas fa-chevron-left"></i> Danh sách đơn</a>
</div>

<div class="row">
    <div class="col-lg-7 mb-4">
        <div class="card shadow">
            <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">Sản phẩm trong đơn</h6></div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Phiên bản</th>
                            <th class="text-center">SL</th>
                            <th class="text-right">Đơn giá</th>
                            <th class="text-right">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td class="small text-muted">@item.VariantDesc</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-right">@string.Format("{0:N0}", item.UnitPrice)</td>
                                <td class="text-right">@string.Format("{0:N0}", item.LineTotal)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="4" class="text-right">Tổng cộng:</th>
                            <th class="text-right text-danger">@string.Format("{0:N0} ₫", Model.TotalAmount)</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow mb-4">
            <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">Khách hàng</h6></div>
            <div class="card-body">
                <p class="mb-1"><strong>Người nhận:</strong> @Model.Customer.FullName</p>
                <p class="mb-1"><strong>Điện thoại:</strong> @Model.Customer.Phone</p>
                <p class="mb-1"><strong>Email:</strong> @(Model.Customer.Email ?? "—")</p>
                <p class="mb-1"><strong>Địa chỉ:</strong> @Model.Customer.Address</p>
                <p class="mb-0"><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <hr />
                    <p class="mb-0"><strong>Ghi chú:</strong> @Model.Note</p>
                }
            </div>
        </div>

        <div class="card shadow mb-4">
            <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">Cập nhật trạng thái</h6></div>
            <div class="card-body">
                @using (Html.BeginForm("UpdateStatus", "Order", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.OrderId" />
                    <div class="form-group">
                        <select name="status" class="form-control">
                            <option value="0" @(Model.Status == AppleShop.Models.OrderStatus.New ? "selected" : "")>Mới</option>
                            <option value="1" @(Model.Status == AppleShop.Models.OrderStatus.Processing ? "selected" : "")>Đang xử lý</option>
                            <option value="2" @(Model.Status == AppleShop.Models.OrderStatus.Delivered ? "selected" : "")>Đã giao</option>
                            <option value="3" @(Model.Status == AppleShop.Models.OrderStatus.Cancelled ? "selected" : "")>Hủy</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-sync-alt"></i> Cập nhật</button>
                }
                @if (Model.Payments != null && Model.Payments.Any())
                {
                    var payment = Model.Payments.First();
                    <hr />
                    <p class="mb-0 small">
                        <strong>Thanh toán:</strong> @payment.Method —
                        @(payment.Status == AppleShop.Models.PaymentStatus.Paid
                            ? "Đã thanh toán lúc " + (payment.PaidAt.HasValue ? payment.PaidAt.Value.ToString("dd/MM/yyyy HH:mm") : "")
                            : "Chưa thanh toán")
                    </p>
                }
            </div>
        </div>
    </div>
</div>
