@model AppleShop.Models.ViewModels.UserCreateViewModel
@{
    ViewBag.Title = "Thêm tài khoản";
    var allRoles = (List<string>)ViewBag.AllRoles;
}

<h1 class="h3 mb-4 text-gray-800">Thêm tài khoản người dùng</h1>

<div class="card shadow mb-4" style="max-width:640px">
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.LabelFor(m => m.FullName)
                @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.Email)
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "email@example.com" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    @Html.LabelFor(m => m.PhoneNumber)
                    @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
                </div>
                <div class="form-group col-md-6">
                    @Html.LabelFor(m => m.Address)
                    @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    @Html.LabelFor(m => m.Password)
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    <small class="text-muted">Tối thiểu 8 ký tự, gồm chữ hoa, chữ thường và số.</small>
                </div>
                <div class="form-group col-md-6">
                    @Html.LabelFor(m => m.ConfirmPassword)
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                </div>
            </div>

            <div class="form-group">
                <label class="font-weight-bold">Vai trò</label>
                @foreach (var role in allRoles)
                {
                    <div class="custom-control custom-checkbox">
                        <input type="checkbox" class="custom-control-input" id="role-@role"
                               name="Roles" value="@role"
                               @(Model.Roles != null && Model.Roles.Contains(role) ? "checked" : (role == "Customer" ? "checked" : "")) />
                        <label class="custom-control-label" for="role-@role">
                            @role
                            @if (role == "Admin")
                            {
                                <small class="text-muted">— toàn quyền quản trị hệ thống</small>
                            }
                        </label>
                    </div>
                }
                <small class="text-muted">Không chọn gì → mặc định gán vai trò Customer.</small>
            </div>

            <button type="submit" class="btn btn-primary"><i class="fas fa-user-plus"></i> Tạo tài khoản</button>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Hủy</a>
        }
    </div>
</div>
