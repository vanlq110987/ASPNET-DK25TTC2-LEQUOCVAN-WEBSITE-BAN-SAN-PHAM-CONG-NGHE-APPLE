@model List<AppleShop.Models.DistributionChannel>
@{
    ViewBag.Title = "Kênh phân phối";
    var inventoryCounts = (Dictionary<int, int>)ViewBag.InventoryCounts;
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Quản lý Kênh phân phối</h1>
    <a href="@Url.Action("Create")" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Thêm kênh</a>
</div>

<div class="card shadow mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Tên kênh</th>
                        <th>Website</th>
                        <th>Hotline</th>
                        <th>Địa chỉ</th>
                        <th class="text-center">Tồn kho tham chiếu</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center" style="width:140px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        var invCount = inventoryCounts.ContainsKey(c.ChannelId) ? inventoryCounts[c.ChannelId] : 0;
                        <tr>
                            <td>@c.Name</td>
                            <td><a href="@c.Website" target="_blank" rel="noopener">@c.Website</a></td>
                            <td>@c.Hotline</td>
                            <td class="small">@c.Address</td>
                            <td class="text-center">@invCount</td>
                            <td class="text-center">
                                <span class="badge @(c.IsActive ? "badge-success" : "badge-secondary")">
                                    @(c.IsActive ? "Hoạt động" : "Tạm dừng")
                                </span>
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("Edit", new { id = c.ChannelId })" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                                <form action="@Url.Action("Delete", new { id = c.ChannelId })" method="post" class="d-inline"
                                      onsubmit="return confirm('Xóa kênh phân phối này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" @(invCount > 0 ? "disabled title=Còn-tồn-kho-tham-chiếu" : "")>
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
