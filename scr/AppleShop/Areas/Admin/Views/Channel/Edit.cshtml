@model AppleShop.Models.DistributionChannel
@{
    ViewBag.Title = "Sửa kênh phân phối";
}

<h1 class="h3 mb-4 text-gray-800">Sửa kênh phân phối: @Model.Name</h1>

<div class="card shadow mb-4" style="max-width:720px">
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.Partial("_Form", Model)

            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Cập nhật</button>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Hủy</a>
        }
    </div>
</div>
