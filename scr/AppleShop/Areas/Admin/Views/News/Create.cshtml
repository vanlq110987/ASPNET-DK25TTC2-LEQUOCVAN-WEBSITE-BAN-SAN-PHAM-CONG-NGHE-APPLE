@model AppleShop.Models.NewsArticle
@{
    ViewBag.Title = "Viết bài mới";
}

<h1 class="h3 mb-4 text-gray-800">Viết bài mới</h1>

<div class="card shadow mb-4">
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.Partial("_Form", Model)

            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Đăng bài</button>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Hủy</a>
        }
    </div>
</div>

@section scripts {
    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
    <script>CKEDITOR.replace('editor-content');</script>
}
