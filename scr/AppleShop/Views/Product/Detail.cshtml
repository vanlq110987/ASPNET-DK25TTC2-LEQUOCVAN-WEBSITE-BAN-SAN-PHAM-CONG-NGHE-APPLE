@model AppleShop.Models.Product
@{
    ViewBag.Title = Model.Name;
    var reviews = (List<AppleShop.Models.ProductReview>)ViewBag.Reviews;
    var related = (List<AppleShop.Models.Product>)ViewBag.RelatedProducts;
    var channels = (List<AppleShop.Models.DistributionChannel>)ViewBag.AvailableChannels;
    var activeVariants = Model.Variants != null ? Model.Variants.Where(v => v.IsActive).ToList() : new List<AppleShop.Models.ProductVariant>();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb bg-transparent px-0">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Product", new { category = Model.Category.Slug })">@Model.Category.Name</a></li>
        <li class="breadcrumb-item active">@Model.Name</li>
    </ol>
</nav>

<div class="row mb-5">
    <div class="col-md-5 mb-4">
        <img id="main-product-img" class="product-detail-img" src="@Model.ImageUrl" alt="@Model.Name" />
        @if (Model.Images != null && Model.Images.Any())
        {
            <div class="d-flex mt-2" style="gap:.5rem;">
                @foreach (var img in Model.Images.OrderBy(i => i.SortOrder))
                {
                    <img src="@img.Url" class="cart-thumb border" style="cursor:pointer"
                         onclick="document.getElementById('main-product-img').src=this.src" alt="@Model.Name" />
                }
            </div>
        }
    </div>
    <div class="col-md-7">
        <h2>@Model.Name</h2>
        <p class="text-muted">@Model.ShortDescription</p>

        <div class="h4 mb-3">
            @if (Model.SalePrice.HasValue && Model.SalePrice.Value > 0)
            {
                <span class="price-sale">@string.Format("{0:N0} ₫", Model.SalePrice.Value)</span>
                <span class="price-original ml-2">@string.Format("{0:N0} ₫", Model.Price)</span>
            }
            else
            {
                <span class="price-sale">@string.Format("{0:N0} ₫", Model.Price)</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.Need))
        {
            <p><span class="badge badge-need">Nhu cầu: @Model.Need</span></p>
        }

        @if (activeVariants.Any())
        {
            using (Html.BeginForm("Add", "Cart", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label class="font-weight-bold">Chọn phiên bản</label>
                    <select name="variantId" class="form-control" style="max-width:420px">
                        @foreach (var v in activeVariants)
                        {
                            var extra = v.PriceAdjustment != 0
                                ? string.Format(" ({0}{1:N0} ₫)", v.PriceAdjustment > 0 ? "+" : "", v.PriceAdjustment)
                                : "";
                            <option value="@v.VariantId">@v.DisplayName — @v.SpecSummary@extra</option>
                        }
                    </select>
                </div>
                <div class="form-group form-inline">
                    <label class="font-weight-bold mr-2">Số lượng</label>
                    <input type="number" name="quantity" value="1" min="1" max="99" class="form-control qty-input" />
                </div>
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-cart-plus"></i> Thêm vào giỏ hàng
                </button>
            }
        }
        else
        {
            <div class="alert alert-warning">Sản phẩm hiện chưa có phiên bản để bán.</div>
        }

        @if (channels != null && channels.Any())
        {
            <hr />
            <p class="mb-1 font-weight-bold"><i class="fas fa-store"></i> Còn hàng tại kênh phân phối:</p>
            <p>
                @foreach (var ch in channels)
                {
                    <span class="badge badge-secondary mr-1">@ch.Name</span>
                }
            </p>
        }
    </div>
</div>

<!-- Mô tả chi tiết -->
<section class="mb-5">
    <h4 class="border-bottom pb-2 mb-3">Thông tin chi tiết</h4>
    <div class="news-content">
        @Html.Raw(Model.Description)
    </div>
</section>

<!-- Bình luận & đánh giá -->
<section id="reviews" class="mb-5">
    <h4 class="border-bottom pb-2 mb-3">Đánh giá của khách hàng (@reviews.Count)</h4>

    @if (TempData["ReviewSuccess"] != null)
    {
        <div class="alert alert-success">@TempData["ReviewSuccess"]</div>
    }
    @if (TempData["ReviewError"] != null)
    {
        <div class="alert alert-danger">@TempData["ReviewError"]</div>
    }

    @foreach (var r in reviews)
    {
        <div class="media mb-3 border-bottom pb-3">
            <div class="mr-3 text-center">
                <i class="fas fa-user-circle fa-2x text-secondary"></i>
            </div>
            <div class="media-body">
                <h6 class="mb-0">@r.ReviewerName
                    <small class="rating-stars ml-2">
                        @for (int s = 1; s <= 5; s++)
                        {
                            <i class="@(s <= r.Rating ? "fas" : "far") fa-star"></i>
                        }
                    </small>
                </h6>
                <small class="text-muted">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                <p class="mb-0 mt-1">@r.Comment</p>
            </div>
        </div>
    }

    <div class="card mt-4" style="max-width:640px">
        <div class="card-header font-weight-bold">Gửi đánh giá của bạn</div>
        <div class="card-body">
            @using (Html.BeginForm("Review", "Product", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.ProductId" />
                <div class="form-group">
                    <label>Tên của bạn</label>
                    <input type="text" name="reviewerName" class="form-control"
                           value="@(User.Identity.IsAuthenticated ? User.Identity.GetUserName() : "")" />
                </div>
                <div class="form-group">
                    <label>Số sao</label>
                    <select name="rating" class="form-control" style="max-width:160px">
                        <option value="5">5 — Tuyệt vời</option>
                        <option value="4">4 — Tốt</option>
                        <option value="3">3 — Bình thường</option>
                        <option value="2">2 — Tệ</option>
                        <option value="1">1 — Rất tệ</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Nội dung bình luận</label>
                    <textarea name="comment" rows="3" class="form-control" required></textarea>
                </div>
                <button type="submit" class="btn btn-dark"><i class="fas fa-paper-plane"></i> Gửi đánh giá</button>
            }
        </div>
    </div>
</section>

<!-- Sản phẩm liên quan -->
@if (related.Any())
{
    <section>
        <h4 class="border-bottom pb-2 mb-3">Sản phẩm cùng danh mục</h4>
        <div class="row">
            @foreach (var p in related)
            {
                <div class="col-6 col-md-3 mb-4">
                    @Html.Partial("_ProductCard", p)
                </div>
            }
        </div>
    </section>
}
