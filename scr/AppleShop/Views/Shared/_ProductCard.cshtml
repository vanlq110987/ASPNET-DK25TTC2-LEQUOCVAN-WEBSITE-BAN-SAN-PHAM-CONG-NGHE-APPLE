@model AppleShop.Models.Product

<div class="card product-card">
    <a href="@Url.RouteUrl("ProductDetail", new { slug = Model.Slug })">
        <img class="card-img-top" src="@Model.ImageUrl" alt="@Model.Name" loading="lazy" />
    </a>
    <div class="card-body d-flex flex-column">
        <a class="text-dark text-decoration-none" href="@Url.RouteUrl("ProductDetail", new { slug = Model.Slug })">
            <div class="product-name">@Model.Name</div>
        </a>
        <div class="mt-auto">
            @if (!string.IsNullOrEmpty(Model.Need))
            {
                <span class="badge badge-need mb-2">@Model.Need</span>
            }
            <div>
                @if (Model.SalePrice.HasValue && Model.SalePrice.Value > 0)
                {
                    <span class="price-sale">@string.Format("{0:N0} ₫", Model.SalePrice.Value)</span>
                    <span class="price-original ml-1">@string.Format("{0:N0} ₫", Model.Price)</span>
                }
                else
                {
                    <span class="price-sale">@string.Format("{0:N0} ₫", Model.Price)</span>
                }
            </div>
        </div>
    </div>
</div>
