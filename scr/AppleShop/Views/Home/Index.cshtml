@{
    ViewBag.Title = "Trang chủ";
    var featured = (List<AppleShop.Models.Product>)ViewBag.FeaturedProducts;
    var newest = (List<AppleShop.Models.Product>)ViewBag.NewestProducts;
    var news = (List<AppleShop.Models.NewsArticle>)ViewBag.LatestNews;
    var categories = (List<AppleShop.Models.Category>)ViewBag.Categories;
}

<!-- Banner -->
<section class="hero-banner mb-5">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <h1 class="display-4 font-weight-bold">iPhone 16 Pro Max</h1>
            <p class="lead">Titan. Mạnh mẽ. Đẳng cấp — cùng toàn bộ hệ sinh thái Apple chính hãng.</p>
            <a class="btn btn-shop btn-lg" href="@Url.Action("Index", "Product")">
                Mua sắm ngay <i class="fas fa-arrow-right ml-1"></i>
            </a>
        </div>
        <div class="col-lg-4 text-center d-none d-lg-block">
            <i class="fab fa-apple" style="font-size:9rem;"></i>
        </div>
    </div>
</section>

<!-- Danh mục -->
<section class="mb-5">
    <h3 class="mb-3">Danh mục sản phẩm</h3>
    <div class="row">
        @foreach (var c in categories)
        {
            <div class="col-6 col-md-4 col-lg mb-3">
                <a class="btn btn-outline-dark btn-block py-3" href="@Url.Action("Index", "Product", new { category = c.Slug })">
                    @c.Name
                </a>
            </div>
        }
    </div>
</section>

<!-- Sản phẩm nổi bật -->
<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Sản phẩm nổi bật</h3>
        <a href="@Url.Action("Index", "Product")" class="small">Xem tất cả <i class="fas fa-chevron-right"></i></a>
    </div>
    <div class="row">
        @foreach (var p in featured)
        {
            <div class="col-6 col-md-4 col-lg-3 mb-4">
                @Html.Partial("_ProductCard", p)
            </div>
        }
    </div>
</section>

<!-- Sản phẩm mới -->
<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Sản phẩm mới nhất</h3>
        <a href="@Url.Action("Index", "Product")" class="small">Xem tất cả <i class="fas fa-chevron-right"></i></a>
    </div>
    <div class="row">
        @foreach (var p in newest)
        {
            <div class="col-6 col-md-4 col-lg-3 mb-4">
                @Html.Partial("_ProductCard", p)
            </div>
        }
    </div>
</section>

<!-- Tin tức -->
<section>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Tin tức &amp; Khuyến mãi</h3>
        <a href="@Url.Action("Index", "News")" class="small">Xem tất cả <i class="fas fa-chevron-right"></i></a>
    </div>
    <div class="row">
        @foreach (var a in news)
        {
            <div class="col-md-4 mb-4">
                <div class="card news-card h-100">
                    <a href="@Url.RouteUrl("NewsDetail", new { slug = a.Slug })">
                        <img src="@a.ThumbnailUrl" class="card-img-top" alt="@a.Title" loading="lazy" />
                    </a>
                    <div class="card-body">
                        <span class="badge badge-info mb-2">@a.NewsCategory.Name</span>
                        <h6 class="card-title">
                            <a class="text-dark" href="@Url.RouteUrl("NewsDetail", new { slug = a.Slug })">@a.Title</a>
                        </h6>
                        <p class="card-text small text-muted">@a.Summary</p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
