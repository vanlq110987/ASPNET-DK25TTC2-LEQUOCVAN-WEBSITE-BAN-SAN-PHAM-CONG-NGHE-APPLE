@model List<AppleShop.Models.Order>
@{
    ViewBag.Title = "Lịch sử đơn hàng";
}

<h2 class="mb-4"><i class="fas fa-history"></i> Lịch sử đơn hàng</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Bạn chưa có đơn hàng nào. <a href="@Url.Action("Index", "Product")">Mua sắm ngay</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="thead-light">
                <tr>
                    <th>Mã đơn</th>
                    <th>Ngày đặt</th>
                    <th>Người nhận</th>
                    <th class="text-center">Số sản phẩm</th>
                    <th class="text-right">Tổng tiền</th>
                    <th class="text-center">Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td><strong>@o.OrderCode</strong></td>
                        <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@o.Customer.FullName</td>
                        <td class="text-center">@o.Items.Sum(i => i.Quantity)</td>
                        <td class="text-right">@string.Format("{0:N0} ₫", o.TotalAmount)</td>
                        <td class="text-center"><span class="badge @o.StatusBadgeClass">@o.StatusText</span></td>
                        <td class="text-center">
                            <a href="@Url.Action("Details", new { id = o.OrderId })" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
